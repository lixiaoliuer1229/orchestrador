# Production deployments should inject these values as environment variables.
# For local development only, copy this file to .env and replace the placeholders.
APP_ENV=production
APP_REQUEST_TIMEOUT_SECONDS=300
AUTH_ENABLED=true
AUTH_COOKIE_SECURE=true
AUTH_SESSION_HOURS=12

ANTHROPIC_API_KEY=replace-with-your-employee-key
ANTHROPIC_MODEL=coding-chat
ANTHROPIC_BASE_URL=https://llm-gateway.norotech.mx
# Allowed per-request aliases: coding-chat, strong-chat, cheap-chat, minimax-latest.

# Optional: public static-resource directory. Defaults to ./public.
PUBLIC_DIR=

TAVILY_API_KEY=tvly-your-tavily-key-here
# Bounded web-research settings.
RESEARCH_MAX_QUERIES=5
RESEARCH_RESULTS_PER_QUERY=5
RESEARCH_SEARCH_DEPTH=advanced
RESEARCH_SEARCH_CONCURRENCY=3
RESEARCH_SEARCH_TIMEOUT_SECONDS=20
RESEARCH_SEARCH_RETRIES=2
RESEARCH_SOURCE_CHARS=6000
RESEARCH_CONTEXT_CHARS=40000

# Data-agent MySQL connection. Use a read-only database account in production.
MYSQL_HOST=mysql.example.internal
MYSQL_PORT=3306
MYSQL_USER=orchestrador_readonly
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=replace-with-database-name
# Keep TLS enabled for remote databases. Set true only for a trusted local network.
MYSQL_SSL_DISABLED=false
# Server-enforced data-agent limits; the database account must also be read-only.
DATA_AGENT_MAX_ROWS=500
DATA_AGENT_QUERY_TIMEOUT_MS=10000
